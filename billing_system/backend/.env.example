# Copy this file to .env and fill in real credentials.
# NEVER commit the real .env file — it is already in .gitignore.

APP_NAME=Inventory Management System
APP_ENV=development
DEBUG=True

# Supabase Postgres connection string (use the connection pooler URL).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/postgres?ssl=require
DATABASE_URL=

# JWT signing secret (long random string).
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

API_V1_PREFIX=/api/v1

# Supabase project URL and service-role key.
# Find these in the Supabase dashboard under Settings → API.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product_image
LOGO_PATH=./logo.jpg
